#!/usr/bin/env bash
# eduhpx-run: run a program with the measuring MPI and the patched HPX and write the EduHPX run file.
#
#   eduhpx-run [--mpi PREFIX] [--hpx PREFIX] [--out DIR] [--name NAME] [--no-clock] -- mpirun -np 16 ./app args...
#
# It sets the environment (HPX parcel log, MPI log directory, library paths), measures the clock offsets between the
# nodes of a Slurm job, starts the command and, when it is done, makes DIR/run.csv (eduhpx-merge). Open it with EduHPX.
# DIR must be visible on all nodes (shared file system); the logs are small (about 1 MB per rank and second of traffic).
set -uo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
MPI=${EDUHPX_MPI_PREFIX:-}; HPX=${EDUHPX_HPX_PREFIX:-}; OUT=; NAME=; CLOCK=1
usage() { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
while [ $# -gt 0 ]; do
  case $1 in
    --mpi) MPI=$2; shift 2 ;; --hpx) HPX=$2; shift 2 ;; --out) OUT=$2; shift 2 ;; --name) NAME=$2; shift 2 ;;
    --no-clock) CLOCK=0; shift ;; -h|--help) usage 0 ;; --) shift; break ;; *) echo "eduhpx-run: unknown option $1" >&2; usage 1 ;;
  esac
done
[ $# -gt 0 ] || { echo "eduhpx-run: no command (put it after --)" >&2; usage 1; }
OUT=${OUT:-eduhpx_run_$(date +%Y%m%d_%H%M%S)}; mkdir -p "$OUT"; OUT=$(cd "$OUT" && pwd); NAME=${NAME:-$(basename "$OUT")}
libs() { for d in "$1/lib64" "$1/lib"; do [ -d "$d" ] && printf "%s:" "$d"; done; }
[ -n "$MPI" ] && { export PATH="$MPI/bin:$PATH"; export LD_LIBRARY_PATH="$(libs "$MPI")${LD_LIBRARY_PATH:-}"; }
[ -n "$HPX" ] && export LD_LIBRARY_PATH="$(libs "$HPX")${LD_LIBRARY_PATH:-}"
export HPX_PARCEL_LOG="$OUT/parcels" EDUHPX_MPI_LOG_DIR="$OUT"
if ! command -v mpirun >/dev/null 2>&1 && [ -z "${SLURM_JOB_ID:-}" ]; then echo "eduhpx-run: mpirun not found (use --mpi PREFIX)" >&2; exit 1; fi

# several nodes in a Slurm job: offsets between the clocks (ping-pong, as NTP), the merge corrects the times with them
if [ "$CLOCK" = 1 ] && [ "${SLURM_JOB_NUM_NODES:-1}" -gt 1 ] && command -v srun >/dev/null 2>&1; then
  NODES=($(scontrol show hostnames "$SLURM_JOB_NODELIST"))
  { echo "node,index,offset_us"; echo "${NODES[0]},0,0"
    for i in $(seq 1 $((${#NODES[@]} - 1))); do
      srun -N1 -n1 -w "${NODES[0]}" --overlap python3 "$HERE/clock_offset.py" server $((5600 + i)) &
      sleep 1.5
      line=$(srun -N1 -n1 -w "${NODES[$i]}" --overlap python3 "$HERE/clock_offset.py" client "${NODES[0]}" $((5600 + i)))
      wait
      echo "${NODES[$i]},$i,$(echo "$line" | sed -E 's/.*offset \(server - client\) ([+-][0-9.]+) us.*/\1/')"
    done; } > "$OUT/clock_offsets.csv"
fi

# the launcher has to hand the environment on to the other nodes
CMD=("$@")
case $(basename "${CMD[0]}") in
  mpirun|mpiexec) CMD=("${CMD[0]}" -x HPX_PARCEL_LOG -x EDUHPX_MPI_LOG_DIR -x LD_LIBRARY_PATH -x PATH "${CMD[@]:1}") ;;
esac
echo "eduhpx-run: logs go to $OUT"
"${CMD[@]}"; rc=$?
[ $rc -eq 0 ] || echo "eduhpx-run: the program ended with exit code $rc, merging what was recorded" >&2
python3 "$HERE/eduhpx-merge" "$OUT" -o "$OUT/run.csv" --run "$NAME" || { echo "eduhpx-run: merge failed" >&2; exit 1; }
echo "eduhpx-run: done. Open $OUT/run.csv with EduHPX."
exit $rc
