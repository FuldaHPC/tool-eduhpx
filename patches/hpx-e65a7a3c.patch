+// ---------------------------------------------------------------------------------------------
+// EduHPX: parcel log that needs no profiler. With HPX_PARCEL_LOG=<prefix> every parcel event is
+// recorded with the wall clock (microseconds since the epoch) and appended in blocks to the file
+// <prefix>.loc<rank>.csv (rank: OMPI_COMM_WORLD_RANK or PMIX_RANK, else 0). The file is created
+// when the first block is written, an old file with the same name is overwritten.
+// HPX_PARCEL_LOG_MAX_MB (default 2048) caps the size of the file of one process: later events are
+// dropped and a warning is printed at exit.
+//   C,<msb>:<lsb>,<action name>,<creating thread>,<wall_us>   the parcel was handed to the send path
+//   S,<msb>:<lsb>,<size>,<to locality>,<wall_us>              the parcel was sent
+//   R,<msb>:<lsb>,<from locality>,<wall_us>                   the parcel arrived (header decoded)
+//   P,<msb>:<lsb>,<from locality>,<wall_us>,<parent thread>   the action was placed on the scheduler
+//   D,<msb>:<lsb>,<wall_us>                                   load_schedule of the parcel returned
+namespace {
+    struct parcel_log_entry
+    {
+        char kind;
+        std::uint64_t msb, lsb, a, b;
+        std::int64_t wall_us;
+        std::string name;
+    };
+
+    struct parcel_log_t
+    {
+        static constexpr std::size_t block_entries = 8192;
+
+        bool const enabled = std::getenv("HPX_PARCEL_LOG") != nullptr;
+        std::uint64_t const max_bytes = max_megabytes() * 1024ULL * 1024ULL;
+
+        std::mutex mtx;    // guards entries, file, written, dropped; keeps the blocks in order
+        std::vector<parcel_log_entry> entries;
+        std::FILE* file = nullptr;
+        std::uint64_t written = 0;
+        std::uint64_t dropped = 0;
+
+        static std::uint64_t max_megabytes()
+        {
+            char const* mb = std::getenv("HPX_PARCEL_LOG_MAX_MB");
+            long const v = mb != nullptr ? std::atol(mb) : 0;
+            return v > 0 ? static_cast<std::uint64_t>(v) : 2048;
+        }
+
+        static std::int64_t now_us() noexcept
+        {
+            return std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::system_clock::now().time_since_epoch())
+                .count();
+        }
+
+        void add(char kind, std::uint64_t msb, std::uint64_t lsb, std::uint64_t a, std::uint64_t b)
+        {
+            push({kind, msb, lsb, a, b, now_us(), {}});
+        }
+
+        void add_named(char kind, std::uint64_t msb, std::uint64_t lsb, std::uint64_t a, char const* name)
+        {
+            std::int64_t const us = now_us();
+            std::string n = name != nullptr ? name : "";
+            for (char& c : n)
+                if (c == ',' || c == '\n')
+                    c = ';';
+            push({kind, msb, lsb, a, 0, us, std::move(n)});
+        }
+
+        void push(parcel_log_entry&& e)
+        {
+            std::lock_guard<std::mutex> l(mtx);
+            if (written >= max_bytes)
+            {
+                ++dropped;
+                return;
+            }
+            entries.push_back(std::move(e));
+            if (entries.size() >= block_entries)
+                write_block();
+        }
+
+        // caller holds mtx
+        void write_block()
+        {
+            if (file == nullptr)
+            {
+                char const* rank = std::getenv("OMPI_COMM_WORLD_RANK");
+                if (rank == nullptr)
+                    rank = std::getenv("PMIX_RANK");
+                std::string const name = std::string(std::getenv("HPX_PARCEL_LOG")) + ".loc" + (rank ? rank : "0") + ".csv";
+                file = std::fopen(name.c_str(), "w");
+                if (file == nullptr)
+                {
+                    std::fprintf(stderr, "HPX parcel log: cannot open %s, events are dropped\n", name.c_str());
+                    written = max_bytes;
+                    entries.clear();
+                    return;
+                }
+                static char buffer[1 << 20];
+                std::setvbuf(file, buffer, _IOFBF, sizeof(buffer));
+            }
+            for (auto const& e : entries)
+            {
+                int n = 0;
+                if (e.kind == 'S')
+                    n = std::fprintf(file, "S,%016llx:%016llx,%llu,%llu,%lld\n", (unsigned long long) e.msb,
+                        (unsigned long long) e.lsb, (unsigned long long) e.a, (unsigned long long) e.b, (long long) e.wall_us);
+                else if (e.kind == 'C')
+                    n = std::fprintf(file, "C,%016llx:%016llx,%s,%llu,%lld\n", (unsigned long long) e.msb,
+                        (unsigned long long) e.lsb, e.name.c_str(), (unsigned long long) e.a, (long long) e.wall_us);
+                else if (e.kind == 'D')
+                    n = std::fprintf(file, "D,%016llx:%016llx,%lld\n", (unsigned long long) e.msb,
+                        (unsigned long long) e.lsb, (long long) e.wall_us);
+                else if (e.kind == 'R')
+                    n = std::fprintf(file, "R,%016llx:%016llx,%llu,%lld\n", (unsigned long long) e.msb,
+                        (unsigned long long) e.lsb, (unsigned long long) e.a, (long long) e.wall_us);
+                else
+                    n = std::fprintf(file, "P,%016llx:%016llx,%llu,%lld,%llu\n", (unsigned long long) e.msb,
+                        (unsigned long long) e.lsb, (unsigned long long) e.a, (long long) e.wall_us, (unsigned long long) e.b);
+                if (n > 0)
+                    written += static_cast<std::uint64_t>(n);
+            }
+            entries.clear();
+        }
+
+        ~parcel_log_t()
+        {
+            if (!enabled)
+                return;
+            std::lock_guard<std::mutex> l(mtx);
+            if (!entries.empty())
+                write_block();
+            if (file != nullptr)
+                std::fclose(file);
+            if (dropped != 0)
+                std::fprintf(stderr, "HPX parcel log: size cap of %llu MB reached, %llu events were dropped "
+                    "(raise HPX_PARCEL_LOG_MAX_MB)\n", (unsigned long long) (max_bytes >> 20), (unsigned long long) dropped);
+        }
+    };
+
+    parcel_log_t& parcel_log()
+    {
+        static parcel_log_t log;
+        return log;
+    }
